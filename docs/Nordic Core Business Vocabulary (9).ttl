ncbv:MembershipBasedRepresentationRule
        rdf:type                      owl:Class;
        rdfs:comment                  "A class that replaces the previous \"Simple Representation Rule\" class (partially); example: a mandate granted to \"a man on the street\", pointing at a certain person as a  Member of the Mandator (Membership in this case could be \"mandatee\" or similar)."@en;
        rdfs:isDefinedBy              ncbv:;
        rdfs:label                    "Membership Based Representation Rule"@en;
        rdfs:subClassOf               ncbv:RepresentationRule;
        dcterms:created               "2025-09-29T08:42:42.614Z"^^xsd:dateTime;
        dcterms:identifier            "MembershipBasedRepresentationRule"^^xsd:NCName;
        dcterms:modified              "2025-10-06T07:36:42.045Z"^^xsd:dateTime;
        dcterms:subject               <https://iri.suomi.fi/terminology/nbvoc/concept-84>;
        owl:equivalentClass           [ rdf:type            owl:Class;
                                        owl:intersectionOf  ( [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:definesValidMembership;
                                                                owl:someValuesFrom  ncbv:Membership
                                                              ]
