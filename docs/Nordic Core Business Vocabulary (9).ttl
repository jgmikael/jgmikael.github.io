ncbv:CompositeRepresentationRule
        rdf:type                      owl:Class;
        rdfs:comment                  "A class that replaces the \"Complex Representation Rule\" in previous NCBV versions; example of a composite rule for general signatory rights (legal representation): \"CEO alone and two board members jointly\""@fi;
