ncbv:RepresentationRule
        rdf:type                      owl:Class;
        rdfs:comment                  "A rule that describes who or which agents a mandate is granted to. \n\nThe rule can be used both in the case of legal representation, when a CEO or a board member signs for the agent (company) based on their official role in the company, as well as when a mandate is given to a specific person (\"a man on the street\") who has no previous affiliation to the mandating agent."@en;
        rdfs:isDefinedBy              ncbv:;
        rdfs:label                    "Representation Rule (Signatory Rule)"@en;
        rdfs:subClassOf               owl:Thing;
        dcterms:created               "2024-12-03T09:04:01.057Z"^^xsd:dateTime;
        dcterms:identifier            "RepresentationRule"^^xsd:NCName;
        dcterms:modified              "2025-05-13T10:34:35.499Z"^^xsd:dateTime;
        dcterms:subject               <https://iri.suomi.fi/terminology/nbvoc/concept-6011>;
        owl:equivalentClass           [ rdf:type            owl:Class;
                                        owl:intersectionOf  ( [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:description;
                                                                owl:someValuesFrom  rdfs:Literal
                                                              ]
                                                              [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:sequence;
                                                                owl:someValuesFrom  rdfs:Literal
                                                              ]
                                                            )
                                      ];
        suomi-meta:creator            "5dc030a4-740f-4dde-9548-4e6e797899d8";
        suomi-meta:modifier           "5dc030a4-740f-4dde-9548-4e6e797899d8";
        suomi-meta:publicationStatus  <http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/SUGGESTED> .

ncbv:prefLabel  rdf:type              owl:DatatypeProperty;
        rdfs:comment                  "The preferred label attribute is used to name the actual scope of the Mandate; example: \"Car Purchase\"; \"Filing a Declaration (of some type)\"; or using a specific national eService (mandates given in the Swedish Mina Ombud or the Finnish Suomi.fi eAuthorizations).  "@en;
        rdfs:isDefinedBy              ncbv:;
        rdfs:label                    "Preferred Label"@en;
        rdfs:range                    rdfs:Literal;
