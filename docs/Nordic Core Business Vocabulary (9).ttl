                                                                owl:someValuesFrom  skos:Concept
                                                              ]
                                                              [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:minimumNumberOfMembers;
                                                                owl:someValuesFrom  rdfs:Literal
                                                              ]
                                                            )
                                      ];
