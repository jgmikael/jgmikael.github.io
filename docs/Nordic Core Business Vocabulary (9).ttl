ncbv:Membership  rdf:type             owl:Class;
        rdfs:comment                  "The Membership class describes certain types of relationships between agents (persons and legal entities). \n\nA person can be a member of an association, employed by a company, be a board member in or the CEO of a limited company.\n\nThe official definition of Membership can be found here: \nhttps://www.w3.org/TR/vocab-org/#org:Membership\n\nThis technical note does not change the content of the official definition of the Membership class.\n\nUpper class: \nhttps://www.w3.org/ns/org#Membership"@en;
        rdfs:isDefinedBy              ncbv:;
        rdfs:label                    "Membership"@en;
        rdfs:subClassOf               owl:Thing;
        dcterms:created               "2024-12-03T09:04:01.057Z"^^xsd:dateTime;
        dcterms:identifier            "Membership"^^xsd:NCName;
        dcterms:modified              "2025-05-21T07:59:55.235Z"^^xsd:dateTime;
        dcterms:subject               <https://iri.suomi.fi/terminology/nbvoc/concept-78>;
        owl:equivalentClass           [ rdf:type            owl:Class;
                                        owl:intersectionOf  ( [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:hasRole;
                                                                owl:someValuesFrom  ncbv:Role
                                                              ]
                                                              [ rdf:type            owl:Restriction;
                                                                owl:onProperty      ncbv:member;
                                                                owl:someValuesFrom  ncbv:Agent
                                                              ]
                                                            )
                                      ];
        suomi-meta:creator            "5dc030a4-740f-4dde-9548-4e6e797899d8";
        suomi-meta:modifier           "5dc030a4-740f-4dde-9548-4e6e797899d8";
        suomi-meta:publicationStatus  <http://uri.suomi.fi/codelist/interoperabilityplatform/interoperabilityplatform_status/code/SUGGESTED> .
