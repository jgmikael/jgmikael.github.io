ncbv:MandateTransfer  rdf:type        owl:Class;
        rdfs:comment                  "A class for documenting the possible transfer (or delegation) of a Mandate from a previous Mandatee to another; example: Mandate is granted by CEO of Company, is delegable, the first Mandatee delegated the Mandate to another Agent who becomes the new Mandatee; the transfer of the Mandate is logged in this class."@en;
        rdfs:isDefinedBy              ncbv:;
        rdfs:label                    "Mandate Transfer"@en;
        rdfs:subClassOf               ncbv:Source;
        dcterms:created               "2025-06-13T08:22:56.154Z"^^xsd:dateTime;
