# Context files and their mentions
<https://jgmikael.github.io/docs/gam/v0.1/vocabulary.context.jsonld> a jsonld:Context ;
    schema:mentions
        authz:Activity,
        authz:Agent,
        authz:AssignmentRequirement,
        authz:AssignmentRule,
        authz:Audit,
        authz:Authority,
        authz:Authorization,
        authz:AuthorizationActivity,
        authz:AuthorizationRule,
        authz:AuthorizationScope,
        authz:EconomicOperator,
        authz:Entity,
        authz:Involvement,
        authz:InvolvementSelection,
        authz:JuridicalPrecedence,
        authz:Law,
        authz:LegalBasis,
        authz:PeriodOfTime,
        authz:Person,
        authz:Restriction,
        authz:Role,
        authz:Rule,
        authz:RuleOperator,
        authz:Scope,
        authz:auditedAuthorization,
        authz:dateOfIssue,
        authz:delegable,
        authz:description,
        authz:endDate,
        authz:endedAtTime,
        authz:hasAgent,
        authz:hasApplicableLaw,
        authz:hasAssignmentRequirement,
        authz:hasAssignmentRule,
        authz:hasAuthorizationRule,
        authz:hasAuthorizationScope,
        authz:hasInvolvement,
        authz:hasLegalBasis,
        authz:hasOperandRule,
        authz:hasOperator,
        authz:hasRestriction,
        authz:hasRole,
        authz:hasRuleOperator,
        authz:hasSelection,
        authz:hasSubrestriction,
        authz:hasSubrule,
        authz:identifier,
        authz:involvementPeriod,
        authz:isDocumentedIn,
        authz:qualifiedAssociation,
        authz:replaces,
        authz:selectsInvolvement,
        authz:startDate,
        authz:startedAtTime,
        authz:title,
        authz:transactionDateTime,
        authz:unit,
        authz:used,
        authz:validDuring,
        authz:value,
        authz:wasGeneratedBy ;
.

