.

authz:hasOperator a rdf:Property, owl:ObjectProperty ;
    rdfs:range authz:RuleOperator ;
    rdfs:label "has operator" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:hasRestriction a rdf:Property, owl:ObjectProperty ;
    rdfs:domain authz:AuthorizationScope ;
