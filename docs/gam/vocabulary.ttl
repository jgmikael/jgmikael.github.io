# Class definitions
authz:Activity a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Activity" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:Agent a rdfs:Class ;
    rdfs:subClassOf foaf:Agent, prov:Agent ;
    rdfs:label "Agent" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:AssignmentRequirement a rdfs:Class ;
    rdfs:label "Assignment Requirement" ;
