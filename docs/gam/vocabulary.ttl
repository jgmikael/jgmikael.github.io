    vs:term_status "stable" ;
.

authz:identifier a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (authz:AssignmentRule authz:Audit authz:Authorization authz:AuthorizationRule authz:Involvement authz:JuridicalPrecedence authz:Law authz:Rule) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Identifier" ;
