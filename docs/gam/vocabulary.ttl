@prefix authz: <https://iri.suomi.fi/model/authz/> .
@prefix eu-core: <https://iri.suomi.fi/model/eu-core/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix schema: <http://schema.org/> .
@prefix jsonld: <http://www.w3.org/ns/json-ld#> .

# Ontology definition
authz: a owl:Ontology ;
    dc:title """General Authorisation Model"""@en ;
    dc:description """Vocabulary serving both Nordic DQS work as well as EU WE BUILD LSP."""^^rdf:HTML ;
    dc:date "2026-09-29"^^xsd:date ;
.

# Property definitions
authz:auditedAuthorization a rdf:Property, owl:ObjectProperty ;
    rdfs:domain authz:Audit ;
    rdfs:range authz:Authorization ;
    rdfs:label "audited authorisation" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:dateOfIssue a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain authz:Authorization ;
    rdfs:range xsd:date ;
    rdfs:label "Date of Issue" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:delegable a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain authz:Authorization ;
    rdfs:range xsd:boolean ;
    rdfs:label "Delegable" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:description a rdf:Property, owl:DatatypeProperty ;
    rdfs:domain [ a owl:Class; owl:unionOf (authz:AssignmentRule authz:AuthorizationRule authz:JuridicalPrecedence authz:Law) ] ;
    rdfs:range xsd:string ;
    rdfs:label "Description" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:endDate a rdf:Property, owl:DatatypeProperty ;
    rdfs:range xsd:date ;
    rdfs:label "End Date" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:endedAtTime a rdf:Property, owl:DatatypeProperty ;
    rdfs:range xsd:dateTime ;
    rdfs:label "Ended at Time" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:hasAgent a rdf:Property, owl:ObjectProperty ;
    rdfs:domain authz:Involvement ;
    rdfs:range authz:Agent ;
    rdfs:label "has agent" ;
    rdfs:isDefinedBy <https://iri.suomi.fi/model/authz/>, <https://iri.suomi.fi/model/authz/> ;
    vs:term_status "stable" ;
.

authz:hasApplicableLaw a rdf:Property, owl:ObjectProperty ;
    rdfs:domain authz:LegalBasis ;
