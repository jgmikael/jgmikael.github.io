<urn:example:ownership:omar-indirect-record> a oa:OwnerRecord ;
    oa:effectiveDate "2026-09-01"^^xsd:date ;
    oa:evidence <urn:example:ownership:holding-register> ;
    oa:interest <urn:example:ownership:omar-indirect-baltic> ;
    oa:ownerJurisdiction "FI" ;
    oa:ownerType "Person" ;
    oa:party <urn:example:ownership:omar> .

<urn:example:ownership:omar-to-holding> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "50% of the holding company" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:direct ;
