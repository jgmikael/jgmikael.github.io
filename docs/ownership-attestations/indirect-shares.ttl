@prefix cred: <https://www.w3.org/2018/credentials#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ebwv: <https://w3id.org/ebwv#> .
@prefix oa: <https://jgmikael.github.io/docs/ownership-attestations/profile#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:example:ownership:indirect-attestation> a oa:OwnershipAttestation,
        ebwv:ElectronicAttestationOfAttributes,
        cred:VerifiableCredential ;
    rdfs:label "Direct and indirect share ownership" ;
    oa:assessedOn "2026-10-05"^^xsd:date ;
    oa:contentStatus oa:fictionalUnsigned ;
    oa:credentialType "eu.we-build:ownership:1" ;
    oa:holderKeyReference <urn:example:ownership:placeholder-public-key> ;
    oa:ownerRecord <urn:example:ownership:aino-indirect-record>,
        <urn:example:ownership:holding-record>,
        <urn:example:ownership:leena-record>,
        <urn:example:ownership:omar-indirect-record> ;
    oa:status <urn:example:ownership:indirect-attestation-status> ;
    ebwv:attestationLegalCategory ebwv:EAA ;
    cred:credentialSubject <urn:example:ownership:baltic-parts> ;
    cred:issuer <urn:example:ownership:baltic-parts> ;
    cred:validFrom "2026-10-05T09:00:00+00:00"^^xsd:dateTime ;
    cred:validUntil "2026-11-04T09:00:00+00:00"^^xsd:dateTime .

<urn:example:ownership:aino-address> a ebwv:Address ;
    ebwv:adminUnitL1 "FI"^^ebwv:CountryCode ;
    ebwv:adminUnitL2 "Example Region" ;
    ebwv:locatorDesignator "1" ;
    ebwv:postCode "00100" ;
    ebwv:postName "Helsinki" ;
    ebwv:thoroughfare "Example Street" .

<urn:example:ownership:aino-indirect-baltic> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "30% indirect economic ownership" ;
    oa:calculation "50% × 60% = 30%" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:indirect ;
    oa:quantityMeaning "Equivalent economic units: 50% × 600 shares. Not 300 registered shares in the person’s name." ;
    oa:shareClass oa:ordinary ;
    oa:shareQuantity 300 ;
    ebwv:effectivePeriod <urn:example:ownership:aino-indirect-baltic-period> ;
    ebwv:exerciseMode oa:alone ;
    ebwv:hasRelationshipPath ( <urn:example:ownership:aino-to-holding> <urn:example:ownership:holding-to-baltic> ) ;
    ebwv:ownershipPercentage 30.0 ;
    ebwv:relationshipTarget <urn:example:ownership:baltic-parts> ;
    ebwv:relationshipType oa:economicEntitlement ;
    ebwv:rightHolder <urn:example:ownership:aino> ;
    ebwv:supportedBy <urn:example:ownership:holding-register> .

<urn:example:ownership:aino-indirect-baltic-period> a ebwv:PeriodOfTime ;
    ebwv:startDate "2026-09-01"^^xsd:date .

<urn:example:ownership:aino-indirect-record> a oa:OwnerRecord ;
    oa:effectiveDate "2026-09-01"^^xsd:date ;
    oa:evidence <urn:example:ownership:holding-register> ;
    oa:interest <urn:example:ownership:aino-indirect-baltic> ;
    oa:ownerJurisdiction "FI" ;
    oa:ownerType "Person" ;
    oa:party <urn:example:ownership:aino> .

<urn:example:ownership:aino-to-holding> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "50% of the holding company" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:direct ;
    oa:shareClass oa:ordinary ;
    oa:shareQuantity 50 ;
    ebwv:effectivePeriod <urn:example:ownership:aino-to-holding-period> ;
    ebwv:exerciseMode oa:alone ;
    ebwv:ownershipPercentage 50.0 ;
    ebwv:relationshipTarget <urn:example:ownership:kallio-holding> ;
    ebwv:relationshipType oa:legalTitle ;
    ebwv:rightHolder <urn:example:ownership:aino> ;
    ebwv:supportedBy <urn:example:ownership:holding-register> .

<urn:example:ownership:aino-to-holding-period> a ebwv:PeriodOfTime ;
    ebwv:startDate "2026-09-01"^^xsd:date .

<urn:example:ownership:baltic-parts-address> a ebwv:Address ;
    ebwv:adminUnitL1 "FI"^^ebwv:CountryCode ;
    ebwv:adminUnitL2 "Example Region" ;
    ebwv:locatorDesignator "1" ;
    ebwv:postCode "00100" ;
    ebwv:postName "Helsinki" ;
    ebwv:thoroughfare "Example Street" .

<urn:example:ownership:holding-record> a oa:OwnerRecord ;
    oa:effectiveDate "2026-09-01"^^xsd:date ;
    oa:evidence <urn:example:ownership:baltic-register> ;
    oa:interest <urn:example:ownership:holding-to-baltic> ;
    oa:ownerJurisdiction "FI" ;
    oa:ownerType "Entity" ;
    oa:party <urn:example:ownership:kallio-holding> .

<urn:example:ownership:holding-to-baltic-period> a ebwv:PeriodOfTime ;
    ebwv:startDate "2026-09-01"^^xsd:date .

<urn:example:ownership:indirect-attestation-status> a oa:StatusReference ;
    oa:statusIndex 0 ;
    oa:statusList <https://issuer.example/status/demo> ;
    oa:statusPurpose "revocation" .

<urn:example:ownership:kallio-holding-address> a ebwv:Address ;
    ebwv:adminUnitL1 "FI"^^ebwv:CountryCode ;
    ebwv:adminUnitL2 "Example Region" ;
    ebwv:locatorDesignator "1" ;
    ebwv:postCode "00100" ;
    ebwv:postName "Helsinki" ;
    ebwv:thoroughfare "Example Street" .

<urn:example:ownership:leena-address> a ebwv:Address ;
    ebwv:adminUnitL1 "FI"^^ebwv:CountryCode ;
    ebwv:adminUnitL2 "Example Region" ;
    ebwv:locatorDesignator "1" ;
    ebwv:postCode "00100" ;
    ebwv:postName "Helsinki" ;
    ebwv:thoroughfare "Example Street" .

<urn:example:ownership:leena-record> a oa:OwnerRecord ;
    oa:effectiveDate "2026-09-01"^^xsd:date ;
    oa:evidence <urn:example:ownership:baltic-register> ;
    oa:interest <urn:example:ownership:leena-to-baltic> ;
    oa:ownerJurisdiction "FI" ;
    oa:ownerType "Person" ;
    oa:party <urn:example:ownership:leena> .

<urn:example:ownership:leena-to-baltic> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "40% direct shares" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:direct ;
    oa:shareClass oa:ordinary ;
    oa:shareQuantity 400 ;
    ebwv:effectivePeriod <urn:example:ownership:leena-to-baltic-period> ;
    ebwv:exerciseMode oa:alone ;
    ebwv:ownershipPercentage 40.0 ;
    ebwv:relationshipTarget <urn:example:ownership:baltic-parts> ;
    ebwv:relationshipType oa:legalTitle ;
    ebwv:rightHolder <urn:example:ownership:leena> ;
    ebwv:supportedBy <urn:example:ownership:baltic-register> .

<urn:example:ownership:leena-to-baltic-period> a ebwv:PeriodOfTime ;
    ebwv:startDate "2026-09-01"^^xsd:date .

<urn:example:ownership:omar-address> a ebwv:Address ;
    ebwv:adminUnitL1 "FI"^^ebwv:CountryCode ;
    ebwv:adminUnitL2 "Example Region" ;
    ebwv:locatorDesignator "1" ;
    ebwv:postCode "00100" ;
    ebwv:postName "Helsinki" ;
    ebwv:thoroughfare "Example Street" .

<urn:example:ownership:omar-indirect-baltic> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "30% indirect economic ownership" ;
    oa:calculation "50% × 60% = 30%" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:indirect ;
    oa:quantityMeaning "Equivalent economic units: 50% × 600 shares. Not 300 registered shares in the person’s name." ;
    oa:shareClass oa:ordinary ;
    oa:shareQuantity 300 ;
    ebwv:effectivePeriod <urn:example:ownership:omar-indirect-baltic-period> ;
    ebwv:exerciseMode oa:alone ;
    ebwv:hasRelationshipPath ( <urn:example:ownership:omar-to-holding> <urn:example:ownership:holding-to-baltic> ) ;
    ebwv:ownershipPercentage 30.0 ;
    ebwv:relationshipTarget <urn:example:ownership:baltic-parts> ;
    ebwv:relationshipType oa:economicEntitlement ;
    ebwv:rightHolder <urn:example:ownership:omar> ;
    ebwv:supportedBy <urn:example:ownership:holding-register> .

<urn:example:ownership:omar-indirect-baltic-period> a ebwv:PeriodOfTime ;
