    ebwv:relationshipType oa:legalTitle ;
    ebwv:rightHolder <urn:example:ownership:kallio-holding> ;
    ebwv:supportedBy <urn:example:ownership:baltic-register> .

<urn:example:ownership:omar> a ebwv:NaturalPerson ;
    rdfs:label "Omar Niemi" ;
    ebwv:dateOfBirth "1987-03-02"^^xsd:date ;
    ebwv:domicile <urn:example:ownership:omar-address> ;
    ebwv:familyName "Niemi" ;
    ebwv:givenName "Omar" .

<urn:example:ownership:baltic-register> a oa:Evidence ;
    rdfs:label "Shareholder register — Baltic Parts" ;
    dct:description """FICTIONAL DEMONSTRATION DOCUMENT — NOT AN AUTHENTIC REGISTER OR LEGAL INSTRUMENT.

Baltic Parts Oy has 1,000 ordinary shares. Kallio Holding Oy owns 600 and Leena Salo owns 400.""" ;
    dct:identifier "DEMO-BALTIC-REGISTER" ;
    oa:evidenceData "RklDVElPTkFMIERFTU9OU1RSQVRJT04gRE9DVU1FTlQg4oCUIE5PVCBBTiBBVVRIRU5USUMgUkVHSVNURVIgT1IgTEVHQUwgSU5TVFJVTUVOVC4KCkJhbHRpYyBQYXJ0cyBPeSBoYXMgMSwwMDAgb3JkaW5hcnkgc2hhcmVzLiBLYWxsaW8gSG9sZGluZyBPeSBvd25zIDYwMCBhbmQgTGVlbmEgU2FsbyBvd25zIDQwMC4="^^xsd:base64Binary ;
    oa:evidenceType oa:officialRegister .

<urn:example:ownership:kallio-holding> a ebwv:Company,
        ebwv:EconomicOperator,
        ebwv:LegalPerson ;
    rdfs:label "Kallio Holding Oy" ;
    oa:entityForm oa:private_company ;
    ebwv:identifier "DEMO-KALLIO-HOLDING" ;
    ebwv:jurisdiction "FI"^^ebwv:CountryCode ;
    ebwv:legalForm "Private limited company" ;
    ebwv:legalIdentifier "FI.DEMO.KALLIO-HOLDING"^^ebwv:Euid ;
    ebwv:legalName "Kallio Holding Oy" ;
    ebwv:registeredAddress <urn:example:ownership:kallio-holding-address> .

<urn:example:ownership:baltic-parts> a ebwv:Company,
        ebwv:EconomicOperator,
        ebwv:LegalPerson ;
    rdfs:label "Baltic Parts Oy" ;
    oa:entityForm oa:private_company ;
    ebwv:identifier "DEMO-BALTIC-PARTS" ;
    ebwv:jurisdiction "FI"^^ebwv:CountryCode ;
    ebwv:legalForm "Private limited company" ;
    ebwv:legalIdentifier "FI.DEMO.BALTIC-PARTS"^^ebwv:Euid ;
    ebwv:legalName "Baltic Parts Oy" ;
    ebwv:registeredAddress <urn:example:ownership:baltic-parts-address> .

<urn:example:ownership:holding-register> a oa:Evidence ;
    rdfs:label "Shareholder register — Kallio Holding" ;
    dct:description """FICTIONAL DEMONSTRATION DOCUMENT — NOT AN AUTHENTIC REGISTER OR LEGAL INSTRUMENT.

Kallio Holding Oy has 100 ordinary shares. Aino Kallio owns 50 and Omar Niemi owns 50. Equal economic rights; no other intermediate entities.""" ;
    dct:identifier "DEMO-HOLDING-REGISTER" ;
    oa:evidenceData ""^^xsd:base64Binary ;
    oa:evidenceType oa:officialRegister .

