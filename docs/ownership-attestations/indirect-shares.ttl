    ebwv:startDate "2026-09-01"^^xsd:date .

<urn:example:ownership:leena> a ebwv:NaturalPerson ;
    rdfs:label "Leena Salo" ;
    ebwv:dateOfBirth "1978-09-21"^^xsd:date ;
    ebwv:domicile <urn:example:ownership:leena-address> ;
    ebwv:familyName "Salo" ;
    ebwv:givenName "Leena" .

<urn:example:ownership:aino> a ebwv:NaturalPerson ;
    rdfs:label "Aino Kallio" ;
    ebwv:dateOfBirth "1984-04-12"^^xsd:date ;
    ebwv:domicile <urn:example:ownership:aino-address> ;
    ebwv:familyName "Kallio" ;
    ebwv:givenName "Aino" .

<urn:example:ownership:holding-to-baltic> a ebwv:OwnershipOrControlRelationship ;
    rdfs:label "60% direct shares" ;
    oa:economicRight oa:dividend_rights,
        oa:liquidation_rights ;
    oa:interestType oa:shareholding ;
    oa:level oa:direct ;
    oa:shareClass oa:ordinary ;
    oa:shareQuantity 600 ;
