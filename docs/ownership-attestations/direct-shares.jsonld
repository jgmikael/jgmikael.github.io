    {
      "@id": "urn:example:ownership:northstar-register",
      "@type": "oa:Evidence",
      "dct:description": "FICTIONAL DEMONSTRATION DOCUMENT — NOT AN AUTHENTIC REGISTER OR LEGAL INSTRUMENT.\n\nAs at 5 October 2026: 1,000 ordinary shares issued. Aino Kallio holds 600; Mikko Laine holds 400. One vote and equal economic rights per share.",
      "dct:identifier": "DEMO-NORTHSTAR-REGISTER",
      "oa:evidenceData": {
        "@type": "xsd:base64Binary",
        "@value": ""
      },
      "oa:evidenceType": {
        "@id": "oa:officialRegister"
      },
      "rdfs:label": "Shareholder register — Northstar"
    },
    {
