      },
      "ebwv:domicile": {
        "@id": "urn:example:ownership:mikko-address"
      },
      "ebwv:familyName": "Laine",
      "ebwv:givenName": "Mikko",
      "rdfs:label": "Mikko Laine"
    },
    {
